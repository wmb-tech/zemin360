{
  "name": "evidex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidex \u2014 evidence-based talent profiles and reasoned matching for the G\u0130RVAK network (Zemin360 Hackathon 2026)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '@evidex/web' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run --filter '*' test",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun --env-file=.env run packages/db/src/migrate.ts",
    "db:seed": "bun --env-file=.env run packages/db/src/seed.ts",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "prettier": "^3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^8.3.0"
  }
}
