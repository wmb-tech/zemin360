# Copy to .env — never commit real values
DATABASE_URL=postgres://evidex:evidex@localhost:5432/evidex
API_PORT=3100
WEB_ORIGIN=http://localhost:5100
SESSION_SECRET=change-me

# GitHub App (talent evidence)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=  # pem, tek satır, \n ile

# LLM (ADR-0002) — provider: google | anthropic | openai | fake
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-pro
# google/vertex: gcloud ADC ya da GOOGLE_APPLICATION_CREDENTIALS ile kimlik; kullanım Cloud Billing'e yazılır
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_API_KEY=   # yalnız AI Studio yolu (prepay kovası), Vertex varsa boş bırak
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Email (magic link, introductions)
SMTP_URL=
EMAIL_FROM=Evidex <no-reply@example.com>
